<!--
  HotHandZ match HUD ("Champion Arcade" look). Hovers above the far edge
  of the arena so it never covers the battlefield. Ids are driven by
  src/game/ui-system.ts: the navy header stays put; the phase is shown by the
  colour of the round line and call-out, and by the tint of the sub-line box.
-->
<style>
  .root { flex-direction: column; width: 460px; background-color: #f5f6f3; border-width: 1px; border-color: #c2d3da; padding-top: 12px; padding-left: 12px; padding-right: 12px; border-radius: 28px; }
  .header { flex-direction: column; gap: 8px; padding-top: 10px; padding-bottom: 12px; padding-left: 18px; padding-right: 18px; background-color: #202b3b; border-top-left-radius: 28px; border-top-right-radius: 28px; }
  .rule { height: 5px; background-color: #70e9d0; }
  .marquee { flex-direction: column; align-items: center; gap: 2px; }
  .sides { flex-direction: row; justify-content: space-between; align-items: center; }
  .side { flex-direction: column; gap: 4px; width: 150px; }
  .right { align-items: flex-end; }
  .who-you { font-size: 14px; font-weight: 700; letter-spacing: 2px; color: #70e9d0; }
  .who-rival { font-size: 14px; font-weight: 700; letter-spacing: 2px; color: #ffb56e; }
  .hp { font-size: 26px; font-weight: 700; color: #ffffff; }
  .track { width: 150px; height: 9px; background-color: #445267; }
  .track-right { width: 150px; height: 9px; background-color: #445267; flex-direction: row; justify-content: flex-end; }
  .fill-you { width: 150px; height: 9px; background-color: #70e9d0; }
  .fill-rival { width: 150px; height: 9px; background-color: #ffb56e; }
  .round { font-size: 14px; font-weight: 700; letter-spacing: 2px; color: #70e9d0; }
  .big { font-size: 40px; font-weight: 700; color: #ffffff; text-align: center; }
  .locks { flex-direction: row; justify-content: space-between; padding-top: 10px; padding-left: 6px; padding-right: 6px; }
  .pill { padding-top: 4px; padding-bottom: 4px; padding-left: 6px; padding-right: 6px; background-color: #bcefe2; }
  .lock { font-size: 14px; font-weight: 700; color: #202b3b; letter-spacing: 1px; }
  .sub-box { margin-top: 10px; padding-top: 16px; padding-bottom: 16px; padding-left: 16px; padding-right: 16px; background-color: #e5edf0; border-radius: 28px; }
  .sub { font-size: 17px; color: #263548; text-align: center; }
  .bottom { flex-direction: row; justify-content: center; gap: 10px; padding-top: 12px; padding-bottom: 14px; }
  .btn { flex-direction: column; background-color: #70e9d0; padding-bottom: 3px; cursor: pointer; border-radius: 999px; }
  .btn-face { flex-direction: row; justify-content: center; align-items: center; gap: 8px; padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px; border-width: 1px; border-radius: 999px; }
  .primary { background-color: #ff8c21; border-color: #ffe3b3; }
  .primary:hover { background-color: #ff9f42; }
  .secondary { background-color: #202b3b; border-color: #202b3b; }
  .secondary:hover { background-color: #2c3a4f; }
  .btn-label { font-size: 16px; font-weight: 700; color: #ffffff; }
  .btn-icon { width: 18px; height: 18px; color: #ffffff; }
</style>
<div class="root">
  <div id="hud-header" class="header">
    <div class="marquee">
      <div id="round-text" class="round">ROUND 1</div>
      <div id="hud-big" class="big">VS</div>
    </div>
    <div class="sides">
      <div class="side">
        <div id="you-label" class="who-you">YOU</div>
        <div id="you-hp" class="hp">100</div>
        <div class="track"><div id="you-fill" class="fill-you"></div></div>
      </div>
      <div class="side right">
        <div id="rival-label" class="who-rival">RIVAL</div>
        <div id="rival-hp" class="hp">100</div>
        <div class="track-right"><div id="rival-fill" class="fill-rival"></div></div>
      </div>
    </div>
  </div>
  <div class="rule"></div>
  <div class="locks">
    <div id="you-lock-pill" class="pill" style="display: none"><div id="you-lock" class="lock">WAITING</div></div>
    <div id="rival-lock-pill" class="pill" style="display: none"><div id="rival-lock" class="lock">WAITING</div></div>
  </div>
  <div id="hud-sub-box" class="sub-box"><div id="hud-sub" class="sub">Get ready</div></div>
  <div class="bottom">
    <div id="rematch-button" class="btn" style="display: none">
      <div class="btn-face primary"><RotateCcw class="btn-icon"></RotateCcw><div class="btn-label">Rematch</div></div>
    </div>
    <div id="leave-button" class="btn" style="display: none">
      <div class="btn-face secondary"><LogOut class="btn-icon"></LogOut><div class="btn-label">Leave</div></div>
    </div>
    <!-- Concede a running match. Press once to arm, again to confirm. -->
    <div id="forfeit-button" class="btn" style="display: none">
      <div id="forfeit-face" class="btn-face secondary"><Flag class="btn-icon"></Flag><div id="forfeit-label" class="btn-label">Forfeit</div></div>
    </div>
    <div id="forfeit-cancel" class="btn" style="display: none">
      <div class="btn-face secondary"><X class="btn-icon"></X><div class="btn-label">Keep playing</div></div>
    </div>
  </div>
</div>
