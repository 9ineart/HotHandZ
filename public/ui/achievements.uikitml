<!--
  Achievements panel, opened from the courtyard kiosk. Seven rows in two
  ladders: hot streaks (5/10/15/20) and total wins (10/20/30). Every one of
  them pays stars into the player's rank, which is why the header carries the
  rank and the star total rather than a decorative count.

  Row ids run ach-0 .. ach-6, each with -title, -detail, -bar, -fill, -stars.
  Content comes from src/game/kiosk-system.ts via ACHIEVEMENTS.
-->
<style>
  .root { flex-direction: column; width: 470px; background-color: #f5f6f3; border-width: 1px; border-color: #c2d3da; border-radius: 28px; }
  .header { flex-direction: row; justify-content: space-between; align-items: center; padding-top: 14px; padding-bottom: 14px; padding-left: 18px; padding-right: 14px; background-color: #202b3b; border-top-left-radius: 28px; border-top-right-radius: 28px; }
  .title { font-size: 20px; font-weight: 700; letter-spacing: 2px; color: #ffffff; }
  .close { width: 34px; height: 34px; justify-content: center; align-items: center; background-color: #2c3a4f; cursor: pointer; border-radius: 999px; }
  .close:hover { background-color: #ff8c21; }
  .close-icon { width: 18px; height: 18px; color: #ffffff; }
  .rule { height: 5px; background-color: #70e9d0; }
  .summary { flex-direction: row; justify-content: space-between; align-items: center; padding-top: 12px; padding-bottom: 12px; padding-left: 18px; padding-right: 18px; background-color: #e5edf0; }
  .rank { font-size: 17px; font-weight: 700; color: #202b3b; }
  .tally { font-size: 15px; font-weight: 700; color: #0e7a65; }
  .list { flex-direction: column; padding-top: 10px; padding-bottom: 14px; padding-left: 14px; padding-right: 14px; gap: 6px; }
  .row { flex-direction: row; align-items: center; gap: 10px; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: #ffffff; border-width: 1px; border-color: #dfe8ec; }
  .texts { flex-direction: column; width: 250px; gap: 3px; }
  .name { font-size: 15px; font-weight: 700; color: #202b3b; }
  .detail { font-size: 12px; color: #5d6c7e; }
  .track { width: 250px; height: 6px; background-color: #e5edf0; }
  .fill { width: 1px; height: 6px; background-color: #70e9d0; }
  .stars { width: 86px; font-size: 14px; font-weight: 700; color: #9c530b; text-align: right; }
  .empty { font-size: 13px; color: #5d6c7e; text-align: center; padding-top: 8px; padding-bottom: 8px; }
</style>
<div class="root">
  <div class="header">
    <div class="title">ACHIEVEMENTS</div>
    <div id="ach-close" class="close"><X class="close-icon"></X></div>
  </div>
  <div class="rule"></div>
  <div class="summary">
    <div id="ach-rank" class="rank">Rookie, 0 stars</div>
    <div id="ach-tally" class="tally">0 / 7 unlocked</div>
  </div>
  <div class="list">
    <div class="row">
      <div class="texts">
        <div id="ach-0-title" class="name">-</div>
        <div id="ach-0-detail" class="detail">-</div>
        <div class="track"><div id="ach-0-fill" class="fill"></div></div>
      </div>
      <div id="ach-0-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-1-title" class="name">-</div>
        <div id="ach-1-detail" class="detail">-</div>
        <div class="track"><div id="ach-1-fill" class="fill"></div></div>
      </div>
      <div id="ach-1-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-2-title" class="name">-</div>
        <div id="ach-2-detail" class="detail">-</div>
        <div class="track"><div id="ach-2-fill" class="fill"></div></div>
      </div>
      <div id="ach-2-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-3-title" class="name">-</div>
        <div id="ach-3-detail" class="detail">-</div>
        <div class="track"><div id="ach-3-fill" class="fill"></div></div>
      </div>
      <div id="ach-3-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-4-title" class="name">-</div>
        <div id="ach-4-detail" class="detail">-</div>
        <div class="track"><div id="ach-4-fill" class="fill"></div></div>
      </div>
      <div id="ach-4-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-5-title" class="name">-</div>
        <div id="ach-5-detail" class="detail">-</div>
        <div class="track"><div id="ach-5-fill" class="fill"></div></div>
      </div>
      <div id="ach-5-stars" class="stars">-</div>
    </div>
    <div class="row">
      <div class="texts">
        <div id="ach-6-title" class="name">-</div>
        <div id="ach-6-detail" class="detail">-</div>
        <div class="track"><div id="ach-6-fill" class="fill"></div></div>
      </div>
      <div id="ach-6-stars" class="stars">-</div>
    </div>
  </div>
</div>
