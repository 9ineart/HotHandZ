# Caddy serves the whole of HotHandZ from one hostname.
#
# The game and the room server share an origin on purpose. NetClient falls back
# to wss://<the page's own host>/hca-ws when VITE_HCA_SERVER_URL is unset, so
# serving both from here means the socket URL never has to be baked into the
# build -- which removes the one deployment step that fails silently if you
# get it wrong. A secure page cannot open an insecure socket either, and Caddy
# obtains and renews the certificate that makes wss:// possible.
#
# Replace the hostname, then:
#   sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

hothandz.nineart.studio {
	# Worth having: the build is ~13 MB and a headset pulls it over Wi-Fi.
	encode zstd gzip

	# The socket. Caddy upgrades WebSocket connections through reverse_proxy
	# with no extra configuration, and rooms.mjs listens only on localhost, so
	# this is the only route to it.
	handle /hca-ws* {
		reverse_proxy 127.0.0.1:8787
	}

	# Everything else is the built game.
	handle {
		root * /srv/hothandz/dist
		try_files {path} /index.html
		file_server
	}
}
