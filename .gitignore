# Dependencies
node_modules/
.pnpm-debug.log*

# Build outputs
dist/
*.tsbuildinfo

# Bubblewrap: the Gradle project it generates, the signed artefacts, and above
# all the signing key. This repository is public, and a published keystore is
# unrecoverable -- the package id and key are paired permanently, so a leak
# means abandoning the Store listing and starting again under a new name. The
# key itself lives outside the repo entirely (see twa/twa-manifest.json);
# these patterns are the second line of defence.
twa/*
!twa/twa-manifest.json
*.keystore
*.jks
*.apk
*.aab

# Environment files
.env
.env.local
.env.production

# IDE and OS files
.vscode/*
!.vscode/extensions.json
.vs/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.lcov

# Render output from the asset/scene preview tooling: regenerated on demand.
artifacts/

# The room server writes this at runtime. A deployed server keeps its own copy
# outside the checkout (HCA_LEADERBOARD_FILE), so the tracked one would only
# ever be local noise -- and leaderboard.mjs creates the directory if missing.
server/data/leaderboard.json

# Runtime and temporary data
pids/
*.pid
*.seed
*.pid.lock
.tmp/
.temp/
.iwsdk/

# MCP configs generated by the CLI
.mcp.json
.cursor/mcp.json
.vscode/mcp.json
.codex/config.toml
